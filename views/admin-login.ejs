<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | <%= appName || 'Petri Collider' %>
  </title>
  <style>
    :root {
      color-scheme: light;
      --ink: #17212b;
      --muted: #64727e;
      --paper: #f4f1e8;
      --panel: #fffdf7;
      --accent: #c95536;
      --line: #17212b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      background: radial-gradient(circle at 15% 15%, #fffaf0 0 18%, transparent 40%), var(--paper);
      color: var(--ink);
      font-family: Georgia, 'Times New Roman', serif;
    }

    .login-panel {
      width: min(100%, 400px);
      padding: 36px;
      border: 2px solid var(--line);
      background: var(--panel);
      box-shadow: 9px 9px 0 var(--ink);
    }

    .eyebrow {
      margin: 0 0 10px;
      color: var(--accent);
      font: 700 0.72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 8px;
      font-size: clamp(2rem, 8vw, 3rem);
      line-height: .95;
    }

    .intro {
      margin: 0 0 28px;
      color: var(--muted);
      font-size: 1rem;
    }

    label {
      display: block;
      margin: 18px 0 7px;
      font: 700 .75rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    input {
      width: 100%;
      padding: 12px 13px;
      border: 1px solid var(--line);
      border-radius: 0;
      background: #fff;
      color: var(--ink);
      font: 1rem ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    input:focus {
      outline: 3px solid #f0b49f;
      outline-offset: 2px;
    }

    button {
      width: 100%;
      margin-top: 26px;
      padding: 13px;
      border: 2px solid var(--line);
      background: var(--ink);
      color: #fffdf7;
      cursor: pointer;
      font: 700 .8rem ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    button:hover {
      background: var(--accent);
    }

    .error,
    .notice {
      margin: 18px 0 0;
      padding: 10px 12px;
      font: .8rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .error {
      border-left: 4px solid var(--accent);
      background: #fff0ea;
      color: #8e2d18;
    }

    .notice {
      border-left: 4px solid #b38b2e;
      background: #fff7d9;
      color: #675016;
    }
  </style>
</head>

<body>
  <main class="login-panel">
    <p class="eyebrow">Restricted console</p>
    <h1>
      <%= appName || 'Petri Collider' %>
    </h1>
    <p class="intro">Sign in to inspect submitted rounds and request metadata.</p>
    <% if (error) { %>
      <p class="error" role="alert">
        <%= error %>
      </p>
      <% } %>
        <% if (!configured) { %>
          <p class="notice">Admin access is not configured. Set <code>ADMIN_USERNAME</code>,
            <code>ADMIN_PASSWORD</code>, and <code>SESSION_SECRET</code> in <code>.env</code>.</p>
          <% } %>
            <form method="post" action="/admin/login">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" autocomplete="username" required autofocus>
              <label for="password">Password</label>
              <input id="password" name="password" type="password" autocomplete="current-password" required>
              <button type="submit">Enter console</button>
            </form>
  </main>
</body>

</html>